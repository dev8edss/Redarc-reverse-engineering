CM_ BO_ 2213741569 "PARTLY_CONFIRMED: Manager30 clock/time frame. Raw CAN ID 0x03F30401, PGN 0x03F304, SA 0x01. Observed payload 9E 06 EA 07 0B 29 08 FF decodes as 2026-06-20 11:41:08 and C4 06 EA 07 0B 2F 19 FF decodes as 2026-06-25 11:47:25 using day = (D1 >> 3) + 1. D8 is padding.";
CM_ SG_ 2213741569 Manager30_Clock_Flags_Raw "UNCONFIRMED_PENDING_TEST: D1 low 3 bits. Examples: 0x9E & 0x07 = 6, 0xC4 & 0x07 = 4.";
CM_ SG_ 2213741569 Manager30_Clock_Day_Of_Month "PARTLY_CONFIRMED: D1 high 5 bits plus 1 gives day-of-month. Examples: 0x9E >> 3 = 19, +1 = 20; 0xC4 >> 3 = 24, +1 = 25.";
CM_ SG_ 2213741569 Manager30_Clock_Month "PARTLY_CONFIRMED: D2 month number. Observed 0x06 in June captures.";
CM_ SG_ 2213741569 Manager30_Clock_Year "PARTLY_CONFIRMED: D3-D4 little-endian year. Observed EA 07 = 2026.";
CM_ SG_ 2213741569 Manager30_Clock_Hour "PARTLY_CONFIRMED: D5 hour, 24-hour clock. Observed 0x0D = 13 in 1:48 PM capture.";
CM_ SG_ 2213741569 Manager30_Clock_Minute "PARTLY_CONFIRMED: D6 minute. Observed 0x30 = 48 in 1:48 PM capture.";
CM_ SG_ 2213741569 Manager30_Clock_Second "PARTLY_CONFIRMED: D7 second; increments once per second in find unknown.csv.";
BA_ "Decode_Status" BO_ 2213741569 "PARTLY_CONFIRMED";
BA_ "Decode_Status" SG_ 2213741569 Manager30_Clock_Day_Of_Month "PARTLY_CONFIRMED";
BA_ "Decode_Status" SG_ 2213741569 Manager30_Clock_Flags_Raw "UNCONFIRMED_PENDING_TEST";
BA_ "Decode_Status" SG_ 2213741569 Manager30_Clock_Month "PARTLY_CONFIRMED";
