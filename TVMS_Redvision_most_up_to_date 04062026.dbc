CM_ BU_ Manager30 "Node 0x01: Manager30 battery charger";
CM_ BU_ Battery_Sensor "Node 0x08: Battery Sensor / BMS sensor";
CM_ BU_ Redvision_1 "Node 0x20: Redvision 1 display, used to press buttons";
CM_ BU_ Redvision_2 "Node 0x21: Redvision 2 display";
CM_ BU_ TVMS_1280 "Node 0x24: TVMS 1280 relay output board, no dimming; includes two temperature sensors and tank inputs";
CM_ BU_ TVMS_Rouge "Node 0x30: TVMS Rouge dimming output board; 10 outputs, 8 button inputs, 2 tank sensors";
CM_ BO_ 2617246256 "Dual water tank level status from TVMS Rouge. Original supplied raw 29-bit CAN ID: 0x1C000230 / 469762608; DBC extended ID uses 0x9C000230 / 2617246256.";
CM_ SG_ 2617246256 WaterLevel_MUX "Multiplexor: 0x09=Tank levels, 0x16=Reserved";
CM_ SG_ 2617246256 TVMSRouge_WaterTank1_Percent "Fresh water tank 1 fill level";
CM_ SG_ 2617246256 TVMSRouge_WaterTank2_Percent "Fresh water tank 2 fill level";
VAL_ 2617246256 WaterLevel_MUX 9 "TankLevels" 22 "Reserved" ;

BA_DEF_ BO_ "GenMsgCycleTime" INT 0 100000;
BA_DEF_DEF_ "GenMsgCycleTime" 0;




CM_ BO_ 2399154208 "TVMS Rouge output on/off command from Redvision 1. Hardware has 10 physical output channels; mux/channel IDs 0x0C-0x15.";
CM_ BO_ 2399219760 "TVMS Rouge dimming command. Hardware has 10 dimmable outputs; target level is 0-100 percent.";
CM_ BO_ 2617053744 "TVMS Rouge output level feedback. Only 10 physical outputs are modelled.";
CM_ BO_ 2617054256 "TVMS Rouge output on/off feedback bitfield. Only 10 physical outputs are modelled.";
CM_ BO_ 2617246256 "TVMS Rouge two tank sensors / water level percent status from supplied DBC.";
CM_ BO_ 2617049136 "TVMS Rouge local inputs: 8 button inputs and 2 analog tank sensor raw channels.";


CM_ "Node names supplied by Steven: 0x01 Manager30, 0x08 Battery Sensor, 0x20 Redvision 1, 0x21 Redvision 2, 0x24 TVMS 1280, 0x30 TVMS Rouge.";
CM_ BU_ Manager30 "Node 0x01: Manager30 battery charger/system manager.";
CM_ BU_ Battery_Sensor "Node 0x08: Battery Sensor / BMS sensor.";
CM_ BU_ Redvision_1 "Node 0x20: Redvision 1 display used to press buttons.";
CM_ BU_ Redvision_2 "Node 0x21: Redvision 2 display.";
CM_ BU_ TVMS_1280 "Node 0x24: TVMS 1280 relay output board: 10 non-dimming outputs plus inverter output, 6 tank inputs, 2 temperature sensors.";
CM_ BU_ TVMS_Rouge "Node 0x30: TVMS Rouge dimming output board: 10 outputs, 8 button inputs, 2 tank sensors.";
CM_ BO_ 2617049124 "TVMS 1280 status/input frame. Hardware has 6 tank inputs; earlier observed button-like bits are kept as raw/observed only.";
CM_ BO_ 2399151136 "TVMS 1280 non-dimming output command frame from Redvision 1. Outputs 1-10 plus inverter output are modelled.";
CM_ BO_ 2617049136 "TVMS Rouge input/tank status frame. Hardware has 8 button inputs and 2 tank sensors.";
CM_ BO_ 2617246256 "TVMS Rouge dual water tank level status. Original supplied raw extended CAN ID: 0x1C000230.";
CM_ BO_ 2399154208 "TVMS Rouge output on/off command frame. Hardware has 10 dimmable outputs.";
CM_ BO_ 2399219760 "TVMS Rouge dimming command frame for outputs 1-10.";

CM_ "Most up to date hardware notes: CAN identifiers are J1939-style 29-bit IDs: priority + PGN + source address. DBC BO_ IDs use the standard extended-ID flag 0x80000000 added to the raw 29-bit CAN ID.";
CM_ "Node names: 0x01 Manager30, 0x08 Battery Sensor, 0x20 Redvision 1, 0x21 Redvision 2, 0x24 TVMS 1280, 0x30 TVMS Rouge.";
CM_ BO_ 2399151136 "Redvision 1 command frame to TVMS 1280. TVMS 1280 has 10 normal relay outputs plus dedicated inverter output. Inverter channel is modelled as mux 11 pending capture confirmation.";
CM_ SG_ 2399151136 TVMS1280_Inverter_State "Dedicated TVMS 1280 inverter output command/status bit; mux 11 is inferred placeholder until a dedicated inverter capture confirms exact channel ID.";
CM_ BO_ 2399154208 "Redvision 1 command frame to TVMS Rouge. TVMS Rouge has 10 outputs with application channel IDs 0x0C-0x15 for outputs 1-10.";
CM_ BO_ 2399219760 "TVMS Rouge dimming command. Output channel mux IDs are 0x0C-0x15 for outputs 1-10; target level raw 0-100 = percent.";
CM_ BO_ 2617053744 "TVMS Rouge output level feedback. Page/mux 0x0C carries outputs 1-7; page/mux 0x13 carries outputs 8-10. These correspond to application channel IDs 0x0C-0x15.";
CM_ BO_ 2617054256 "TVMS Rouge output on/off feedback. Page/mux 0x0C carries outputs 1-7; page/mux 0x13 carries outputs 8-10.";
VAL_ 2399154208 TVMSRouge_Output_Channel 12 "Output_01" 13 "Output_02" 14 "Output_03" 15 "Output_04" 16 "Output_05" 17 "Output_06" 18 "Output_07" 19 "Output_08" 20 "Output_09" 21 "Output_10" ;
VAL_ 2399219760 TVMSRouge_Dim_Channel 12 "Output_01" 13 "Output_02" 14 "Output_03" 15 "Output_04" 16 "Output_05" 17 "Output_06" 18 "Output_07" 19 "Output_08" 20 "Output_09" 21 "Output_10" ;
VAL_ 2399151136 TVMS1280_Output_Channel 1 "Output_01" 2 "Output_02" 3 "Output_03" 4 "Output_04" 5 "Output_05" 6 "Output_06" 7 "Output_07" 8 "Output_08" 9 "Output_09" 10 "Output_10" 11 "Inverter" ;
